OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Local MongoDB: mongodb://localhost:27017
# Docker -> host MongoDB: mongodb://host.docker.internal:27017
# MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=job_matcher

PINECONE_API_KEY=
PINECONE_INDEX_NAME=
# Optional: using the index host avoids an extra index lookup.
PINECONE_INDEX_HOST=

EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-large

# Optional LLM observability with Langfuse. Create these in Langfuse Project Settings > API Keys.
# EU cloud: https://cloud.langfuse.com (default). Use the regional/self-hosted URL when applicable.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development

# Comma-separated frontend origins, without trailing slashes.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Compose port binding; use 0.0.0.0 only when LAN access is needed.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8000

#Jwt
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ISSUER=job-fit-agent
JWT_AUDIENCE=job-fit-api
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15

#redis
REDIS_URL=redis://localhost:6379/0
REFRESH_TOKEN_TTL_SECONDS=1209600
REFRESH_SESSION_MAX_SECONDS=2592000

REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax